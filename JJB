local function Toast(msg, color)
    if ToastObj then ToastObj:Destroy() end
    color = color or T.Chrome
    local t = New("CanvasGroup", {
        Parent = Window, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 50),
        Size = UDim2.fromOffset(330, 38), BackgroundColor3 = Color3.fromRGB(22, 23, 27), GroupTransparency = 1, ZIndex = 50,
    })
    Corner(t, 19)
    Stroke(t, color, 1, 0.4)
    local dot = New("Frame", {
        Parent = t, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 20, 0.5, 0),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = color, BorderSizePixel = 0,
    })
    Corner(dot, 99)
    local l = Text(t, msg, 12, T.Text, F.Medium, UDim2.fromOffset(34, 0), UDim2.new(1, -44, 1, 0))
    l.TextTruncate = Enum.TextTruncate.AtEnd
    ToastObj = t
    Tween(t, 0.65, { Position = UDim2.new(0.5, 0, 1, -18) }, ES.Back)
    Tween(t, 0.3, { GroupTransparency = 0 }, ES.Quad)
    task.delay(0.15, function()
        if dot.Parent then Tween(dot, 0.7, { Size = UDim2.fromOffset(8, 8) }, ES.Elastic) end
    end)
    task.delay(2.6, function()
        if t.Parent then
            Tween(t, 0.4, { Position = UDim2.new(0.5, 0, 1, 50) }, ES.Quint, ED.In)
            Tween(t, 0.35, { GroupTransparency = 1 }, ES.Quad)
            task.delay(0.45, function() if t.Parent then t:Destroy() end end)
        end
    end)
end

