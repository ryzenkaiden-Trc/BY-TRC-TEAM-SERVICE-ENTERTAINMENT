local function Tap(btn, fn)
    local last = 0
    local function fire()
        local now = os.clock()
        if now - last < 0.25 then return end
        last = now
        task.spawn(fn)
    end
    btn.Activated:Connect(fire)
    btn.MouseButton1Click:Connect(fire)
    local down
    btn.InputBegan:Connect(function(i)
        if isPointer(i) then down = Vector2.new(i.Position.X, i.Position.Y) end
    end)
    btn.InputEnded:Connect(function(i)
        if down and isPointer(i) then
            local up = Vector2.new(i.Position.X, i.Position.Y)
            local moved = (up - down).Magnitude
            down = nil
            if moved < 12 then fire() end
        end
    end)
end

