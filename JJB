local function Slider(parent, pos, size, label, min, max, default, fmt, callback)
    local holder = New("Frame", { Parent = parent, Position = pos, Size = size, BackgroundTransparency = 1 })
    Text(holder, label, 12, T.Muted, F.Medium, UDim2.new(), UDim2.new(0.7, 0, 0, 16))
    local valLbl = Text(holder, "", 12, T.Text, F.Bold, UDim2.new(0.7, 0, 0, 0), UDim2.new(0.3, 0, 0, 16), AX.R)
    local bar = New("Frame", { Parent = holder, Position = UDim2.new(0, 0, 0, 25), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Track, BorderSizePixel = 0 })
    Corner(bar, 99)
    local fill = New("Frame", { Parent = bar, Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 })
    Corner(fill, 99)
    Gradient(fill, T.ChromeDk, T.ChromeLt, 0)
    local knob = New("Frame", { Parent = bar, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2 })
    Corner(knob, 99)
    local hit = New("TextButton", { Parent = holder, Position = UDim2.new(0, -6, 0, 14), Size = UDim2.new(1, 12, 0, 24), BackgroundTransparency = 1, Text = "", ZIndex = 3 })
    BlockDrag(hit)

    local function render(v, animate)
        local a = (v - min) / (max - min)
        if animate then
            Tween(fill, 0.12, { Size = UDim2.fromScale(a, 1) }, ES.Quad)
            Tween(knob, 0.12, { Position = UDim2.fromScale(a, 0.5) }, ES.Quad)
        else
            fill.Size = UDim2.fromScale(a, 1)
            knob.Position = UDim2.fromScale(a, 0.5)
        end
        valLbl.Text = string.format(fmt, v)
    end
    render(default, false)

    local dragging = false
    local function setFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local v = min + (max - min) * a
        render(v, true)
        if callback then callback(v) end
    end
    hit.InputBegan:Connect(function(i)
        if isPointer(i) then
            dragging = true
            Tween(knob, 0.35, { Size = UDim2.fromOffset(19, 19) }, ES.Back)
            setFromX(i.Position.X)
        end
    end)
    Bind(UserInputService.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end)
    Bind(UserInputService.InputEnded, function(i)
        if dragging and isPointer(i) then
            dragging = false
            Tween(knob, 0.4, { Size = UDim2.fromOffset(14, 14) }, ES.Back)
        end
    end)
end

