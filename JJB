local function getTech()
    local ok, v = pcall(function()
        if gethiddenproperty then return (gethiddenproperty(Lighting, "Technology")) end
        return Lighting.Technology
    end)
    if ok then return v end
    return nil
end
local function setTech(tech)
    pcall(function()
        if sethiddenproperty then sethiddenproperty(Lighting, "Technology", tech) else Lighting.Technology = tech end
    end)
end

local function getFx(class, name, start)
    local e = Lighting:FindFirstChild(name)
    if e then return e end
    e = Instance.new(class)
    e.Name = name
    for k, v in pairs(start) do e[k] = v end
    e.Parent = Lighting
    return e
end

local function dropFx(name)
    local e = Lighting:FindFirstChild(name)
    if not e then return end
    e.Name = name .. "_x"
    local goal
    if e:IsA("BloomEffect") or e:IsA("SunRaysEffect") then
        goal = { Intensity = 0 }
    elseif e:IsA("ColorCorrectionEffect") then
        goal = { Saturation = 0, Contrast = 0, Brightness = 0 }
    elseif e:IsA("DepthOfFieldEffect") then
        goal = { FarIntensity = 0 }
    end
    if goal then Tween(e, 0.5, goal) end
    task.delay(0.6, function() if e.Parent then e:Destroy() end end)
end

local function applyRTX()
    if not RTX.On then
        for _, n in ipairs({ "TRC_Bloom", "TRC_Rays", "TRC_Grade", "TRC_DOF", "TRC_Atmos" }) do dropFx(n) end
        if savedLight then
            for k, v in pairs(savedLight) do pcall(function() Lighting[k] = v end) end
            savedLight = nil
        end
        if savedTech then setTech(savedTech) savedTech = nil end
        return
    end

    if not savedLight then
        savedLight = {}
        for _, k in ipairs(LIGHT_KEYS) do
            local ok, v = pcall(function() return Lighting[k] end)
            if ok then savedLight[k] = v end
        end
    end
    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
        Lighting.ExposureCompensation = 0.2
    end)

    if RTX.Opt.Bloom then
        local e = getFx("BloomEffect", "TRC_Bloom", { Intensity = 0, Size = 28, Threshold = 0.85 })
        Tween(e, 0.6, { Intensity = RTX.Val.Bloom })
    else dropFx("TRC_Bloom") end

    if RTX.Opt.Rays then
        local e = getFx("SunRaysEffect", "TRC_Rays", { Intensity = 0, Spread = 0.85 })
        Tween(e, 0.6, { Intensity = 0.2 })
    else dropFx("TRC_Rays") end

    if RTX.Opt.Grade then
        local e = getFx("ColorCorrectionEffect", "TRC_Grade", { Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.fromRGB(255, 244, 232) })
        Tween(e, 0.6, { Saturation = RTX.Val.Sat, Contrast = RTX.Val.Con, Brightness = 0.02 })
    else dropFx("TRC_Grade") end

    if RTX.Opt.DOF then
        local e = getFx("DepthOfFieldEffect", "TRC_DOF", { FarIntensity = 0, NearIntensity = 0, FocusDistance = 60, InFocusRadius = 45 })
        Tween(e, 0.6, { FarIntensity = 0.25 })
    else dropFx("TRC_DOF") end

    if RTX.Opt.Future then
        if not savedTech then savedTech = getTech() end
        if getTech() ~= Enum.Technology.Future then setTech(Enum.Technology.Future) end
        if not Lighting:FindFirstChildOfClass("Atmosphere") then
            getFx("Atmosphere", "TRC_Atmos", { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(199, 180, 165), Decay = Color3.fromRGB(120, 100, 90), Glare = 0.2, Haze = 1.2 })
        end
    else
        if savedTech then setTech(savedTech) savedTech = nil end
        dropFx("TRC_Atmos")
    end
end

local function liveRTX()
    if not RTX.On then return end
    local b = Lighting:FindFirstChild("TRC_Bloom")
    if b then b.Intensity = RTX.Val.Bloom end
    local g = Lighting:FindFirstChild("TRC_Grade")
    if g then g.Saturation = RTX.Val.Sat g.Contrast = RTX.Val.Con end
end

