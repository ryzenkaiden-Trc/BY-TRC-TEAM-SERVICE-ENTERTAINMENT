local function Button(parent, text, pos, size, style, onClick)
    local base, hover, tc, rc
    if style == "primary" then
        base, hover, tc, rc = T.Chrome, T.ChromeLt, T.Ink, T.Ink
    elseif style == "light" then
        base, hover, tc, rc = Color3.fromRGB(246, 248, 252), WHITE, T.Ink, T.Ink
    else
        base, hover, tc, rc = Color3.fromRGB(34, 35, 40), Color3.fromRGB(58, 60, 68), T.Text, WHITE
    end

    local holder = New("Frame", { Parent = parent, Position = pos, Size = size, BackgroundTransparency = 1 })
    local b = New("TextButton", {
        Parent = holder, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = base, AutoButtonColor = false,
        Text = text, TextColor3 = tc, Font = F.Bold, TextSize = 13, BorderSizePixel = 0,
    })
    Corner(b, 10)
    if style ~= "ghost" then

        New("UIGradient", { Parent = b, Rotation = 90, Color = ColorSequence.new(WHITE, Color3.fromRGB(168, 171, 180)) })
    end
    local sc = New("UIScale", { Parent = b })
    local rip = New("CanvasGroup", { Parent = b, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3 })
    Corner(rip, 10)

    local hovering = false
    b.MouseEnter:Connect(function()
        hovering = true
        Tween(b, 0.2, { BackgroundColor3 = hover })
        Tween(sc, 0.4, { Scale = 1.045 }, ES.Back)
    end)
    b.MouseLeave:Connect(function()
        hovering = false
        Tween(b, 0.25, { BackgroundColor3 = base })
        Tween(sc, 0.3, { Scale = 1 })
    end)
    b.MouseButton1Down:Connect(function()
        Tween(sc, 0.1, { Scale = 0.93 }, ES.Quad)
        local sz = b.AbsoluteSize
        local rel = UserInputService:GetMouseLocation() - b.AbsolutePosition
        if rel.X < 0 or rel.Y < 0 or rel.X > sz.X or rel.Y > sz.Y then rel = sz / 2 end
        local ring = New("Frame", {
            Parent = rip, AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(rel.X / math.max(sz.X, 1), rel.Y / math.max(sz.Y, 1)),
            Size = UDim2.fromScale(0, 0), SizeConstraint = Enum.SizeConstraint.RelativeXX,
            BackgroundColor3 = rc, BackgroundTransparency = 0.8, BorderSizePixel = 0,
        })
        New("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = ring })
        Tween(ring, 0.6, { Size = UDim2.fromScale(2.6, 2.6) }, ES.Quint)
        Tween(ring, 0.6, { BackgroundTransparency = 1 }, ES.Quad)
        task.delay(0.65, function() if ring.Parent then ring:Destroy() end end)
    end)
    b.MouseButton1Up:Connect(function()
        Tween(sc, 0.55, { Scale = hovering and 1.045 or 1 }, ES.Elastic)
    end)
    Tap(b, function()
        if onClick then onClick() end
    end)
    return holder, b
end

