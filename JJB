    if o.Icon then
        local box = New("Frame", {
            Parent = row, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
            Size = UDim2.fromOffset(28, 28), BackgroundColor3 = WHITE, BackgroundTransparency = 0.92, BorderSizePixel = 0,
