local fAcc, fFrames = 0, 0
Bind(RunService.RenderStepped, function(dt)
    for _, s in ipairs(Spinners) do
        local g = s[1]
        if g.Parent then g.Rotation = (g.Rotation + dt * s[2]) % 360 end
    end
    for _, d in ipairs(Draggables) do d.Step(dt) end
    fAcc = fAcc + dt
    fFrames = fFrames + 1
    if fAcc >= 0.5 then
        pushFps(math.floor(fFrames / fAcc + 0.5))
        fAcc, fFrames = 0, 0
    end
end)

local function getPing()
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok and v then return math.floor(v) end
    return 0
end

task.spawn(function()
    local startT = os.time()
    local pingHist = {}
    while Alive do
        local up = os.time() - startT
        UpLbl.Text = string.format("%02d:%02d:%02d", math.floor(up / 3600), math.floor((up % 3600) / 60), up % 60)

        local p = getPing()
        PingLbl.Text = p .. " ms"
        ChipPing.Text = p .. "ms"
        table.insert(pingHist, p)
        if #pingHist > 10 then table.remove(pingHist, 1) end
        local top = 100
        for _, v in ipairs(pingHist) do top = math.max(top, v) end
        local off = 10 - #pingHist
        for i = 1, 10 do
            local v = pingHist[i - off]
            if v then
                Tween(PingBars[i], 0.6, {
                    Size = UDim2.new(0.08, 0, 0, math.max(3, math.floor(v / top * 50))),
                    BackgroundColor3 = (i == 10) and T.ChromeLt or Color3.fromRGB(70, 72, 80),
                })
            end
        end
        task.wait(1)
    end
end)

local SplashJunk = {}
local SplashRunning = false

local function ClearSplash()
    SplashRunning = false
    for _, o in ipairs(SplashJunk) do
        pcall(function() o:Destroy() end)
    end
    SplashJunk = {}
end

local function Hold(t)
    task.wait(t)
    if not Alive then error("intro aborted", 0) end
end

local function Splash()
    SplashRunning = true
    local W, H = 360, 260
    local LOGO = 60
    local CY   = 64 - H / 2
    local function keep(o) table.insert(SplashJunk, o) return o end

    local function Tracked(parent, str, ts, font, color, cx, cy, gap)
        local glyph, total = {}, 0
        for i = 1, #str do
            local ch = str:sub(i, i)
            local w = ts * 0.45
            if ch ~= " " then
                local ok, v = pcall(function()
                    return TextService:GetTextSize(ch, ts, font, Vector2.new(400, 100)).X
                end)
                w = (ok and v) and v or ts * 0.7
            end
            glyph[i] = w
            total = total + w + gap
        end
        total = total - gap
        local list, x = {}, cx - total / 2
        for i = 1, #str do
            local ch = str:sub(i, i)
            if ch ~= " " then
                local mid = x + glyph[i] / 2
                local lbl = Text(parent, ch, ts, color, font, UDim2.fromOffset(mid, cy), UDim2.fromOffset(glyph[i] + 8, ts + 8), AX.C)
                lbl.AnchorPoint = Vector2.new(0.5, 0.5)
                lbl.TextTransparency = 1
                table.insert(list, { Label = lbl, X = mid, Y = cy })
            end
            x = x + glyph[i] + gap
        end
        return list
    end

    local function Reveal(list, step, dur)
        for n, l in ipairs(list) do
            task.delay(step * (n - 1), function()
                local lb = l.Label
                if not lb.Parent then return end
                lb.Position = UDim2.fromOffset(l.X, l.Y + 8)
                Tween(lb, dur, { TextTransparency = 0 }, ES.Quad)
                Tween(lb, dur + 0.25, { Position = UDim2.fromOffset(l.X, l.Y) }, ES.Quint)
            end)
        end
    end

    local dim = keep(New("Frame", {
        Parent = Gui, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(3, 3, 4),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
    }))
    local blur = keep(New("BlurEffect", { Name = "TRC_IntroBlur", Size = 0, Parent = Lighting }))

    local card = keep(New("CanvasGroup", {
        Parent = Gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, H), BackgroundColor3 = Color3.fromRGB(10, 10, 12),
        GroupTransparency = 1, ZIndex = 3,
    }))
    Corner(card, 18)
    local cardScale = New("UIScale", { Parent = card, Scale = 0.95 })
    local cardBg = New("Frame", { Parent = card, Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 0 })
    New("UIGradient", { Parent = cardBg, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(26, 27, 31), Color3.fromRGB(8, 8, 10)) })
    local cardStroke = Stroke(card, WHITE, 1, 1)
    Spin(New("UIGradient", {
        Parent = cardStroke, Color = CHROME,
        Transparency = NumberSequence.new({ nk(0, 0.1), nk(0.5, 0.9), nk(1, 0.1) }),
    }), 60)

    local topLine = New("Frame", { Parent = card, Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 })
    New("UIGradient", { Parent = topLine, Transparency = NumberSequence.new({ nk(0, 1), nk(0.5, 0.55), nk(1, 1) }) })

    local lg = keep(New("CanvasGroup", {
        Parent = Gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, CY + 14),
        Size = UDim2.fromOffset(LOGO + 44, LOGO + 44), BackgroundTransparency = 1,
        GroupTransparency = 1, ZIndex = 5,
    }))
    local lgScale = New("UIScale", { Parent = lg, Scale = 1 })
    local _, logoPop = Logo(lg, LOGO, UDim2.fromOffset(22, 22))
    logoPop.Scale = 0.88

    local RING = LOGO + 18
    local ring = New("Frame", {
        Parent = lg, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(RING, RING), BackgroundTransparency = 1, BorderSizePixel = 0,
    })
    Corner(ring, math.floor(RING * 0.32))
    local ringStroke = Stroke(ring, WHITE, 1.5, 0)
    Spin(New("UIGradient", {
        Parent = ringStroke, Color = ColorSequence.new(T.Chrome, WHITE),
        Transparency = NumberSequence.new({ nk(0, 1), nk(0.45, 0.92), nk(1, 0.05) }),
    }), 200)

    local titleLetters = Tracked(card, CONFIG.Name, 19, F.Bold, Color3.fromRGB(236, 239, 245), W / 2, 130, 5)
    local subLetters   = Tracked(card, "JJB PS+ CHAR", 10, F.Medium, T.Muted, W / 2, 154, 3.5)

    local BX, BW, BY = 50, 260, 218
    local status = Text(card, "", 11, T.Muted, F.Medium, UDim2.fromOffset(BX, BY - 22), UDim2.fromOffset(190, 14), AX.L)
    status.TextTransparency = 1
    status.TextTruncate = Enum.TextTruncate.AtEnd
    local pctLbl = Text(card, "0%", 11, T.Text, F.Bold, UDim2.fromOffset(BX + BW - 60, BY - 22), UDim2.fromOffset(60, 14), AX.R)
    pctLbl.TextTransparency = 1

    local bar = New("CanvasGroup", {
        Parent = card, Position = UDim2.fromOffset(BX, BY), Size = UDim2.fromOffset(BW, 3),
        BackgroundColor3 = Color3.fromRGB(38, 39, 44), GroupTransparency = 1,
    })
    Corner(bar, 99)
    local fill = New("Frame", { Parent = bar, Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 })
    Gradient(fill, T.ChromeDk, T.ChromeLt, 0)
    local shine = New("Frame", { Parent = fill, Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 })
    local sg = New("UIGradient", {
        Parent = shine, Offset = Vector2.new(-1, 0),
        Transparency = NumberSequence.new({ nk(0, 1), nk(0.5, 0.5), nk(1, 1) }),
    })
    TweenService:Create(sg, TweenInfo.new(1.1, ES.Sine, ED.InOut, -1), { Offset = Vector2.new(1, 0) }):Play()

    local footer = Text(card, CONFIG.Version .. "  |  by " .. CONFIG.Developer, 10, T.Muted, F.Regular, UDim2.fromOffset(0, H - 30), UDim2.new(1, 0, 0, 14), AX.C)
    footer.TextTransparency = 1

    local pv = keep(New("NumberValue", { Parent = Gui, Value = 0 }))
    pv.Changed:Connect(function(v)
        fill.Size = UDim2.fromScale(math.clamp(v / 100, 0, 1), 1)
        pctLbl.Text = math.floor(v + 0.5) .. "%"
    end)
    local function Progress(to, t) Tween(pv, t, { Value = to }, ES.Quint) end

    local function setStatus(msg, col)
        Tween(status, 0.15, { TextTransparency = 1 }, ES.Quad)
        Hold(0.16)
        status.Text = msg
        status.TextColor3 = col or T.Muted
        status.Position = UDim2.fromOffset(BX, BY - 18)
        Tween(status, 0.3, { TextTransparency = 0 }, ES.Quad)
        Tween(status, 0.4, { Position = UDim2.fromOffset(BX, BY - 22) }, ES.Quint)
    end

    Tween(dim, 0.6, { BackgroundTransparency = 0.3 }, ES.Quad)
    Tween(blur, 0.8, { Size = 16 }, ES.Quad)
    Tween(card, 0.5, { GroupTransparency = 0 }, ES.Quad)
    Tween(cardStroke, 0.6, { Transparency = 0 }, ES.Quad)
    Tween(cardScale, 0.8, { Scale = 1 }, ES.Quint)
    Hold(0.3)

    Tween(lg, 0.6, { GroupTransparency = 0 }, ES.Quad)
    Tween(lg, 0.9, { Position = UDim2.new(0.5, 0, 0.5, CY) }, ES.Quint)
    Tween(logoPop, 0.9, { Scale = 1 }, ES.Quint)
    Hold(0.5)

    Reveal(titleLetters, 0.035, 0.45)
    Hold(0.55)
    Reveal(subLetters, 0.014, 0.4)
    Hold(0.4)

    Tween(bar, 0.4, { GroupTransparency = 0 }, ES.Quad)
    Tween(pctLbl, 0.4, { TextTransparency = 0 }, ES.Quad)
    Tween(footer, 0.5, { TextTransparency = 0.35 }, ES.Quad)
    setStatus("Initializing", T.Muted)
    Progress(24, 0.45)
    Hold(0.3)
    setStatus("Verifying access", T.Muted)
    Progress(52, 0.45)
    Hold(0.3)
    setStatus("Welcome, " .. LocalPlayer.Name, T.Green)
    Progress(80, 0.45)
    Hold(0.3)
    setStatus("Loading interface", T.Muted)
    Progress(100, 0.45)
    Hold(0.45)
    setStatus("Ready", T.Green)
    Hold(0.4)

    SplashRunning = false
    Tween(ringStroke, 0.3, { Transparency = 1 }, ES.Quad)
    Tween(card, 0.45, { GroupTransparency = 1 }, ES.Quad)
    Tween(cardStroke, 0.4, { Transparency = 1 }, ES.Quad)
    Tween(cardScale, 0.6, { Scale = 0.97 }, ES.Quint)
    Tween(dim, 0.6, { BackgroundTransparency = 1 }, ES.Quad)
    Tween(blur, 0.6, { Size = 0 }, ES.Quad)
    Hold(0.15)
    Tween(lg, 0.75, { Position = UDim2.new(0, 14 + 23, 0.5, 0) }, ES.Quart, ED.InOut)
    Tween(lgScale, 0.75, { Scale = 46 / LOGO }, ES.Quart, ED.InOut)
    Hold(0.8)
end

task.spawn(function()
    local ok, err = pcall(Splash)
    ClearSplash()
    if not ok and Alive then warn("[TRC SERVICE] intro failed: " .. tostring(err)) end
    if not Alive then return end

    Orb.Visible = true
    OrbPop.Scale = 1
    SetVisible(true)
    SelectPage("Script")
    task.delay(0.6, function()
        if Alive then
            Toast("Welcome, " .. LocalPlayer.DisplayName .. "  |  RightShift to hide", T.Green)
        end
    end)
end)
