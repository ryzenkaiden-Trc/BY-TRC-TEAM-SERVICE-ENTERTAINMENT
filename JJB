local Draggables = {}
local ActiveDrag = nil

local function anchorPx(obj)
    local ap, as, g = obj.AbsolutePosition, obj.AbsoluteSize, Gui.AbsolutePosition
    return ap.X - g.X + obj.AnchorPoint.X * as.X, ap.Y - g.Y + obj.AnchorPoint.Y * as.Y
end

local function MakeDraggable(handles, target, opts)
    opts = opts or {}
    if typeof(handles) == "Instance" then handles = { handles } end
    local d = {
        Held = false, Dragging = false, Settling = false,
        SX = 0, SY = 0, GX = 0, GY = 0, CX = 0, CY = 0, Start = Vector3.new(),
    }
    table.insert(Draggables, d)

    local function clampGoal(gx, gy)
        local vp = Gui.AbsoluteSize
        local w, h = target.AbsoluteSize.X, target.AbsoluteSize.Y
        local ax, ay = target.AnchorPoint.X, target.AnchorPoint.Y
        local keep = opts.Keep or math.huge
        local kx, ky = math.min(w, keep), math.min(h, keep)
        local lMin = -(w - kx)
        local left = math.clamp(gx - ax * w, lMin, math.max(vp.X - kx, lMin))
        local tMin = opts.KeepTop and 0 or -(h - ky)
        local top = math.clamp(gy - ay * h, tMin, math.max(vp.Y - ky, tMin))
        return left + ax * w, top + ay * h
    end

    local function onBegin(i)
        if not isPointer(i) or ActiveDrag or not Alive then return end
        ActiveDrag = d
        task.defer(function()
            if DragBlocked or not Alive then
                if ActiveDrag == d then ActiveDrag = nil end
                return
            end
            d.Held, d.Dragging = true, false
            d.Start = i.Position
            d.SX, d.SY = anchorPx(target)
            d.GX, d.GY, d.CX, d.CY = d.SX, d.SY, d.SX, d.SY
        end)
    end
    for _, h in ipairs(handles) do
        h.InputBegan:Connect(onBegin)
    end

    Bind(UserInputService.InputChanged, function(i)
        if not d.Held then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local dx, dy = i.Position.X - d.Start.X, i.Position.Y - d.Start.Y
        if not d.Dragging and (math.abs(dx) + math.abs(dy)) > 5 then
            d.Dragging, d.Settling = true, true
            if opts.OnStart then task.spawn(opts.OnStart) end
        end
        if d.Dragging then
            d.GX, d.GY = clampGoal(d.SX + dx, d.SY + dy)
        end
    end)

    Bind(UserInputService.InputEnded, function(i)
        if d.Held and isPointer(i) then
            d.Held = false
            if ActiveDrag == d then ActiveDrag = nil end
            if d.Dragging then
                d.Dragging = false
                if opts.OnEnd then task.spawn(opts.OnEnd) end
            elseif opts.OnTap then
                task.spawn(opts.OnTap)
            end
        end
    end)

    function d.Step(dt)
        if not d.Settling then return end
        local a = 1 - math.exp(-dt * 20)
        d.CX = d.CX + (d.GX - d.CX) * a
        d.CY = d.CY + (d.GY - d.CY) * a
        local vp = Gui.AbsoluteSize
        target.Position = UDim2.fromScale(d.CX / math.max(vp.X, 1), d.CY / math.max(vp.Y, 1))
        if not d.Dragging and math.abs(d.GX - d.CX) < 0.25 and math.abs(d.GY - d.CY) < 0.25 then
            d.Settling = false
            target.Position = UDim2.fromScale(d.GX / math.max(vp.X, 1), d.GY / math.max(vp.Y, 1))
        end
    end
    return d
end

