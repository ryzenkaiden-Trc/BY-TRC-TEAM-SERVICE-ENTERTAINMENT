        tx = 50
        row.MouseEnter:Connect(function() Tween(ic.Frame, 0.4, { Position = UDim2.new(0.5, 4, 0.5, 0) }, ES.Back) end)
        row.MouseLeave:Connect(function() Tween(ic.Frame, 0.4, { Position = UDim2.fromScale(0.5, 0.5) }, ES.Back) end)
