local PageOrder = { Script = 1, Credit = 2, Perf = 3 }
local SwitchToken = 0

local function SelectPage(id)
    if CurrentPage == id then return end
    local prevId = CurrentPage
    CurrentPage = id
    SwitchToken = SwitchToken + 1
    local token = SwitchToken
    local dir = 0
    if prevId then dir = (PageOrder[id] > PageOrder[prevId]) and 1 or -1 end

    Tween(Indicator, 0.6, { Position = UDim2.fromOffset(TAB_X, NavBtn[id].Y) }, ES.Back)
    for k, nb in pairs(NavBtn) do
        local sel = (k == id)
        nb.Icon.SetColor(sel and T.Ink or T.Muted, 0.25)
        Tween(nb.Label, 0.25, { TextColor3 = sel and T.Ink or T.Muted })
    end
    local ic = NavBtn[id].Icon
    ic.Scale.Scale = ic.Base * 0.55
    Tween(ic.Scale, 0.8, { Scale = ic.Base }, ES.Elastic)

    Tween(PageTitle, 0.15, { TextTransparency = 1 }, ES.Quad)
    Tween(PageSub, 0.15, { TextTransparency = 1 }, ES.Quad)
    task.delay(0.15, function()
        local meta = PageMeta[CurrentPage]
        PageTitle.Text, PageSub.Text = meta[1], meta[2]
        PageTitle.Position = UDim2.fromOffset(36, 9)
        PageSub.Position = UDim2.fromOffset(44, 31)
        Tween(PageTitle, 0.35, { TextTransparency = 0 }, ES.Quad)
        Tween(PageSub, 0.35, { TextTransparency = 0 }, ES.Quad)
        Tween(PageTitle, 0.6, { Position = UDim2.fromOffset(20, 9) }, ES.Back)
        Tween(PageSub, 0.6, { Position = UDim2.fromOffset(20, 31) }, ES.Back)
    end)

    local prev = prevId and Pages[prevId]
    if prev then
        for _, s in ipairs(prev.Sections) do
            SecTween(s, 0.22, 1, ES.Quad, ED.In)
        end
        if prev.Tw then prev.Tw:Cancel() end
        prev.Tw = Tween(prev.Scroller, 0.22, { Position = UDim2.fromOffset(-dir * 26, 0) }, ES.Quad, ED.In)
        task.delay(0.24, function()
            if token == SwitchToken then prev.Frame.Visible = false end
        end)
    end

    local pg = Pages[id]
    if pg.Tw then pg.Tw:Cancel() end
    pg.Frame.Visible = true
    pg.Scroller.CanvasPosition = Vector2.new(0, 0)
    pg.Scroller.Position = (dir == 0) and UDim2.fromOffset(0, 30) or UDim2.fromOffset(dir * 40, 0)
    local lead = prev and 0.14 or 0.05
    task.delay(lead, function()
        if token == SwitchToken then
            pg.Tw = Tween(pg.Scroller, 0.8, { Position = UDim2.new() }, ES.Back)
        end
    end)
    for i, s in ipairs(pg.Sections) do
        if s.Tw then s.Tw:Cancel() end
        s.Frame.GroupTransparency = 1
        task.delay(0.075 * (i - 1) + lead, function()
            if token == SwitchToken then
                SecTween(s, 0.8, s.Rest, ES.Quad, ED.Out)
            end
        end)
    end
end

