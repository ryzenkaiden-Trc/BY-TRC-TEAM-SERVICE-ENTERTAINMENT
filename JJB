local function validImage(b)
    return type(b) == "string" and #b > 100 and (b:sub(1, 3) == "\255\216\255" or b:sub(1, 4) == "\137PNG")
end

local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and validImage(res) then return res end
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if req then
        local ok2, r = pcall(req, { Url = url, Method = "GET" })
        if ok2 and type(r) == "table" and validImage(r.Body) then return r.Body end
    end
    return nil
end

local function loadAsset(key)
    local a = ASSETS[key]
    task.spawn(function()
        local ok, err = pcall(function()
            local toAsset = getcustomasset or getsynasset
            if not (writefile and isfile and toAsset) then error("executor has no writefile/isfile/getcustomasset") end

            local useDir = makefolder and isfolder
            if useDir and not isfolder(ASSET_DIR) then makefolder(ASSET_DIR) end
            local path = useDir and (ASSET_DIR .. "/" .. a.File) or ("TRC_" .. a.File)

            local cached = false
            if isfile(path) then
                if readfile then
                    local okr, data = pcall(readfile, path)
                    cached = okr and validImage(data)
                else
                    cached = true
                end
            end

            if not cached then
                local body = httpGet(a.Url)
                if not body then error("download failed") end
                writefile(path, body)
            end

            local asset = toAsset(path)
            if not asset or asset == "" then error("getcustomasset returned nothing") end
            Assets[key] = asset
        end)
        if not ok then
            warn("[TRC SERVICE] image '" .. key .. "' not loaded: " .. tostring(err))
            return
        end
        if Alive then
            for _, fn in ipairs(AssetHooks[key] or {}) do task.spawn(fn, Assets[key]) end
        end
    end)
end

local function OnAsset(key, fn)
    if Assets[key] then
        task.spawn(fn, Assets[key])
        return
    end
    AssetHooks[key] = AssetHooks[key] or {}
    table.insert(AssetHooks[key], fn)
end

for key in pairs(ASSETS) do loadAsset(key) end

