local FpsHist = {}
local function pushFps(fps)
    table.insert(FpsHist, fps)
    if #FpsHist > 30 then table.remove(FpsHist, 1) end
    local sum, mn, mx = 0, math.huge, 0
    for _, v in ipairs(FpsHist) do
        sum = sum + v
        mn = math.min(mn, v)
        mx = math.max(mx, v)
    end
    local avg = math.floor(sum / #FpsHist + 0.5)

    local col, state = T.Green, "Smooth"
    if fps < 30 then col, state = T.Red, "Laggy" elseif fps < 50 then col, state = T.Chrome, "Moderate" end

    FpsBig.Text = string.format('%d <font size="16" color="rgb(138,142,152)">FPS</font>', fps)
    Tween(FpsBig, 0.3, { TextColor3 = col })
    Tween(FpsStatePill, 0.3, { BackgroundColor3 = col })
    FpsStateLbl.TextColor3 = col
    FpsStateLbl.Text = state
    ChipAvg.Text, ChipMin.Text, ChipMax.Text = tostring(avg), tostring(mn), tostring(mx)
    OverlayText.Text = string.format('FPS <font color="%s">%d</font>', rgbStr(col), fps)

    local scale = math.max(60, mx) * 1.15
    Tween(Line60, 0.4, { Position = UDim2.fromScale(0, 1 - 60 / scale) })
    local offset = 30 - #FpsHist
    for i = 1, 30 do
        local v = FpsHist[i - offset]
        local bar = FpsBars[i]
        if v then
            bar.Visible = true
            Tween(bar, 0.45, {
                Size = UDim2.new(0.026, 0, math.clamp(v / scale, 0.02, 1), 0),
                BackgroundColor3 = (i == 30) and T.ChromeLt or Color3.fromRGB(150, 154, 164),
            })
        end
    end
end

