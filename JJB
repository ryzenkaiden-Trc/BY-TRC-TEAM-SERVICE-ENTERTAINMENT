local function SecTween(s, t, goal, style, dir)
    if s.Tw then s.Tw:Cancel() end
    s.Tw = Tween(s.Frame, t, { GroupTransparency = goal }, style or ES.Quad, dir or ED.Out)
end

local function NewSection(page, title)
    local sec = { N = 0, Rest = 0 }
    sec.Frame = New("CanvasGroup", {
        Parent = page.Scroller, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.Panel, BackgroundTransparency = 0.15, BorderSizePixel = 0,
        LayoutOrder = #page.Sections + 1,
    })
    Corner(sec.Frame, 12)
    Stroke(sec.Frame, T.Stroke, 1, 0.5)
    New("UIPadding", {
        Parent = sec.Frame, PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
    })
    New("UIListLayout", { Parent = sec.Frame, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
    sec.Head = Text(sec.Frame, string.upper(title), 10, T.Muted, F.Bold, UDim2.new(), UDim2.new(1, 0, 0, 16))
    sec.Head.LayoutOrder = 0
    table.insert(page.Sections, sec)
    return sec
end

local function nextOrder(sec)
    sec.N = sec.N + 1
    return sec.N
end

local function Row(sec, h, still)
    local row = New("Frame", {
        Parent = sec.Frame, LayoutOrder = nextOrder(sec), Size = UDim2.new(1, 0, 0, h),
        BackgroundColor3 = T.Panel2, BackgroundTransparency = 0.35, BorderSizePixel = 0,
    })
    Corner(row, 10)
    if not still then
        local bar = New("Frame", {
            Parent = row, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(3, 0), BackgroundColor3 = T.ChromeLt, BorderSizePixel = 0,
        })
        Corner(bar, 99)
        row.MouseEnter:Connect(function()
            Tween(row, 0.2, { BackgroundTransparency = 0.05 })
            Tween(bar, 0.45, { Size = UDim2.fromOffset(3, 22) }, ES.Back)
