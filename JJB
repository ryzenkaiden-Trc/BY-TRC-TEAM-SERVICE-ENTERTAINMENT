local function MakeIcon(kind, parent, center, px, color)
    local holder = New("Frame", {
        Parent = parent, AnchorPoint = Vector2.new(0.5, 0.5), Position = center,
        Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1,
    })
    local base = px / 24
    local sc = New("UIScale", { Parent = holder, Scale = base })
    local tints = {}
    IconBuilders[kind](holder, tints)
    local obj = { Frame = holder, Scale = sc, Base = base }
    function obj.SetColor(c, t)
        for _, p in ipairs(tints) do
            if t and t > 0 then
                Tween(p[1], t, { [p[2]] = c })
            else
                p[1][p[2]] = c
            end
        end
    end
    obj.SetColor(color or T.Text)
    return obj
end

